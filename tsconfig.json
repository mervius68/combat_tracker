{
    "compilerOptions": {
        "moduleResolution": "node",
        "esModuleInterop": true,
        "module": "commonjs",
        "allowJs": true,
        "checkJs": true,
        "outDir": "public",
        "target": "esnext",
        "noEmit": false,
    },
    "include": ["**/*.ts", "app.js"], 
    "exclude": ["**/app.ts"]
}